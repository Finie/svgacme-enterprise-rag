{
  "name": "nest-typescript-starter",
  "version": "1.0.0",
  "description": "Nest TypeScript starter repository",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "deploy": "nest deploy",
    "format": "prettier --write \"apps/**/*.ts\" \"test/**/*.ts\"",
    "start": "npm run build && node --env-file-if-exists=.env dist/main",
    "start:dev": "npm run build && concurrently -k -n build,alias,run \"nest build --watch\" \"tsc-alias -p tsconfig.build.json -w\" \"node --env-file-if-exists=.env --watch dist/main.js\"",
    "start:debug": "npm run build && concurrently -k -n build,alias,run \"nest build --watch\" \"tsc-alias -p tsconfig.build.json -w\" \"node --env-file-if-exists=.env --watch --inspect dist/main.js\"",
    "start:prod": "node --env-file-if-exists=.env dist/main",
    "lint": "oxlint apps/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "generate:enterprise": "tsx scripts/generate-enterprise.ts",
    "generate:master-data": "tsx scripts/generate-master-data.ts",
    "generate:policies": "tsx scripts/generate-policies.ts",
    "validate:consistency": "tsx scripts/validate-consistency.ts",
    "generate:scenarios": "tsx scripts/generate-scenarios.ts",
    "generate:test-questions": "tsx scripts/generate-test-questions.ts",
    "generate:data": "npm run generate:enterprise && npm run generate:master-data && npm run generate:policies && npm run generate:scenarios && npm run generate:test-questions && npm run validate:data",
    "validate:data-model": "tsx scripts/validate-data-model.ts",
    "validate:data": "npm run validate:consistency && npm run validate:data-model",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "db:seed": "tsx scripts/database/seed.ts",
    "db:validate": "tsx scripts/database/validate-database.ts",
    "db:studio": "prisma studio",
    "db:setup": "npm run db:up -- --wait && npm run db:generate && npm run db:migrate && npm run db:seed && npm run db:validate && npm run db:studio",
    "knowledge:build": "tsx scripts/knowledge/build-knowledge.ts",
    "knowledge:validate": "tsx scripts/knowledge/validate-knowledge.ts",
    "embeddings:build": "tsx scripts/embeddings/build-embeddings.ts",
    "embeddings:validate": "tsx scripts/embeddings/validate-embeddings.ts",
    "embeddings:smoke": "tsx scripts/embeddings/smoke.ts",
    "knowledge:setup": "npm run knowledge:build && npm run knowledge:validate && npm run embeddings:smoke && npm run embeddings:build && npm run embeddings:validate -- --require-complete",
    "search:semantic": "tsx scripts/embeddings/search-semantic.ts",
    "evaluate:retrieval": "tsx scripts/evaluation/evaluate-retrieval.ts",
    "search:benchmark": "tsx scripts/embeddings/benchmark.ts",
    "test:embeddings:integration": "vitest run --config vitest.config.e2e.ts test/embeddings.e2e-spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/observe": "^0.1.8",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "17.4.2",
    "pg": "8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "^10.0.5",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "prisma": "7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsc-alias": "^1.9.5",
    "tslib": "^2.8.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
