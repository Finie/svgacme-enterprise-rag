# Optional: telemetry starts only when both credentials are non-empty.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# Local database. Copy to .env and replace the password in BOTH places.
POSTGRES_DB=svga_enterprise
POSTGRES_USER=svga
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://svga:replace_with_a_local_password@127.0.0.1:5432/svga_enterprise

# Derived knowledge: character targets; scenarios require explicit selection.
CHUNK_SIZE=1600
CHUNK_OVERLAP=200
KNOWLEDGE_SCENARIO_IDS=

# Embeddings: only policy knowledge chunks are eligible. No answer generation.
# Configured provider is Google (gemini-embedding-001, output truncated to
# 1536 dims via outputDimensionality to match vector(1536); see
# docs/embeddings/provider.md). Alternative: EMBEDDING_PROVIDER=openai with
# EMBEDDING_MODEL=text-embedding-3-small or text-embedding-3-large.
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
EMBEDDING_VERSION=content-v1
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_MS=30000
EMBEDDING_MAX_RETRIES=3
